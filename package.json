{
  "name": "lrbridge",
  "version": "0.6.0",
  "description": "Local HTTP bridge and Web Controller for controlling Adobe Lightroom Classic from Bitfocus Companion, Stream Deck, Loupedeck, PowerShell, curl, scripts, and other HTTP-capable tools.",
  "main": "app/main.js",
  "scripts": {
    "test:color-grading": "node tests/color-grading.js",
    "test:color-grading-transport": "node tests/color-grading-transport.js",
    "test:lens-blur": "node tests/lens-blur.js",
    "test:section-collapse": "node tests/controller-section-collapse.js",
    "test:basic-categorical": "node tests/basic-profile-white-balance.js",
    "test:profile": "node tests/profile-native.js",
    "test:profile-amount": "node tests/profile-amount.js",
    "test:develop-categorical": "node tests/develop-categorical.js",
    "test:tone-curve": "node tests/tone-curve-splits.js",
    "test:point-curve": "node tests/point-curve.js",
    "test:hdr-develop": "node tests/hdr-develop-settings.js",
    "test": "npm run test:point-color && npm run test:color-grading && npm run test:color-grading-transport && npm run test:profile && npm run test:profile-amount && npm run test:basic-categorical && npm run test:develop-categorical && npm run test:lens-blur && npm run test:section-collapse && npm run test:contract && npm run test:sliders && npm run test:hdr-develop && npm run test:tone-curve && npm run test:point-curve && npm run test:lens-corrections && npm run test:desktop-tray && npm run test:desktop-renderer && npm run test:desktop-quit && npm run test:lifecycle && npm run test:input && npm run test:queue && npm run test:diagnostics && npm run test:transport && npm run test:http-transport && npm run test:controller-proxy && npm run test:controller-feedback && npm run test:controller-color-grading && npm run test:controller-http && npm run test:http-builder && npm run test:controller-commands && npm run test:controller-shutdown && npm run test:lua-polling && npm run test:lua-selection && npm run test:polling-contract && npm run test:constrain-crop && npm run test:enhance",
    "test:point-color": "node tests/point-color.js",
    "test:constrain-crop": "node tests/constrain-crop.js",
    "test:lens-corrections": "node tests/controller-lens-corrections.js && node tests/lens-corrections-server.js",
    "test:enhance": "node tests/enhance-denoise.js",
    "start": "electron app/main.js",
    "smoke": "node tests/http-smoke.js",
    "test:contract": "node tests/contract-baseline.js",
    "test:sliders": "node tests/generic-develop-sliders.js",
    "test:lifecycle": "node tests/lifecycle.js",
    "test:input": "node tests/input-validation.js",
    "test:queue": "node tests/queue-resilience.js",
    "test:diagnostics": "node tests/queue-diagnostics.js",
    "test:transport": "node tests/transport-limits.js",
    "test:http-transport": "node tests/http-transport-limits.js",
    "test:controller-proxy": "node tests/controller-proxy.js",
    "test:controller-feedback": "node tests/controller-feedback-snapshot-proxy.js",
    "test:controller-input": "node tests/input-validation.js",
    "test:controller-color-grading": "node tests/controller-color-grading.js",
    "test:controller-http": "node tests/controller-http-limits.js",
    "test:http-builder": "node tests/http-builder-command-surface.js",
    "test:controller-shutdown": "node tests/controller-shutdown.js",
    "test:controller-commands": "node tests/controller-command-tabs.js",
    "test:desktop-tray": "node tests/desktop-minimize-tray.js",
    "test:desktop-renderer": "node tests/desktop-minimize-renderer.js",
    "test:desktop-quit": "node tests/desktop-quit-confirmation.js",
    "test:lua-polling": "node tests/lua-polling-resilience.js",
    "test:lua-selection": "node tests/lua-selection-dispatch.js",
    "test:polling-contract": "node tests/polling-command-contract.js",
    "test:smoke-live": "node tests/http-smoke.js",
    "app": "electron app/main.js",
    "server": "node bridge.js",
    "generate:cheatsheet": "node tools/generate-companion-cheatsheet.js",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "npm run pack:win && powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-portable-zip.ps1"
  },
  "keywords": [
    "lightroom",
    "lightroom-classic",
    "adobe-lightroom",
    "lightroom-controller",
    "lightroom-http-api",
    "lightroom-bridge",
    "bitfocus-companion",
    "generic-http-requests",
    "stream-deck",
    "streamdeck",
    "loupedeck",
    "control-surface",
    "photo-editing",
    "electron",
    "nodejs",
    "lua"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "extraResources": [
      {
        "from": "server/windows-lightroom-native.ps1",
        "to": "native/windows-lightroom-native.ps1"
      }
    ]
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
